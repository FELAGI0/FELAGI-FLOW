# Прод-.env для локальных worker и scheduler.
#
# API работает на Render Free, а worker и scheduler крутятся на локальном ПК и
# подключаются к той же Neon БД, что и API. Использование:
#
#   cp .env.prod.example .env
#   # заполнить DATABASE_URL (Neon) и секреты ниже
#   docker compose up -d worker scheduler
#
# Подробности и ограничения — docs/deploy.md, секция «Worker и Scheduler — локально».

# ---- Neon (тот же DATABASE_URL, что задан на Render) ----
# Строку можно вставить как есть, с sslmode=require — бэкенд сам приводит её к
# asyncpg и включает TLS (см. app/shared/db.py::normalize_database_url).
DATABASE_URL=postgresql://<user>:<password>@ep-xxxx.<region>.aws.neon.tech/neondb?sslmode=require

# ---- Секреты (должны совпадать со значениями в Render) ----
# JWT_SECRET_KEY обязателен: settings не стартует без него (и compose требует
# его интерполяцию на уровне всего файла, даже если запускаются только worker/scheduler).
JWT_SECRET_KEY=
# FERNET_KEY: тот же ключ, что на Render — иначе расходящееся шифрование секретов.
FERNET_KEY=

# ---- LLM (OpenAI-совместимый API; совпадает с Render) ----
LLM_API_KEY=
LLM_BASE_URL=http://185.221.214.224:4100/v1
LLM_MODELS=["gpt-5.6-luna"]

LOG_LEVEL=INFO

# ---- Required интерполяцией compose (postgres не запускается, но переменные
# нужны — подстановка в docker-compose.yml идёт по всему файлу) ----
POSTGRES_USER=felagi
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=felagi
POSTGRES_TEST_DB=felagi_test
POSTGRES_PORT=5433