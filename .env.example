# cp .env.example .env — docker compose подхватит значения автоматически
POSTGRES_USER=felagi
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=felagi
# БД для pytest (см. docker/postgres/init-test-db.sh) — отдельная от рабочей:
# conftest.py делает drop_all/create_all и снёс бы схему POSTGRES_DB
POSTGRES_TEST_DB=felagi_test
# Порт Postgres на хосте (публикуется только на 127.0.0.1) — нужен для pytest
# с хоста и psql. Менять, если 5432 занят локальным Postgres.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://felagi:change_me_in_prod@postgres:5432/felagi
# для pytest с хоста: тот же порт, что POSTGRES_PORT, и БД POSTGRES_TEST_DB
TEST_DATABASE_URL=postgresql+asyncpg://felagi:change_me_in_prod@127.0.0.1:5432/felagi_test
# сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# значение ниже — только для разработки; в проде заменить
JWT_SECRET_KEY=dev-only-insecure-change-me-9f3c1a7e5b2d8460
# JSON-массив разрешённых моделей LLM-узла; пусто = любые (см. DESIGN.md §1)
LLM_MODELS=[]
LOG_LEVEL=INFO
# ключ и адрес OpenAI-совместимого API для LLM-узла.
# Без ключа LLM-узел возвращает ошибку шага, остальное работает.
LLM_API_KEY=
LLM_BASE_URL=http://185.221.214.224:4100/v1
# база для ссылок-приглашений: {FRONTEND_URL}/invite/{token}
FRONTEND_URL=http://localhost
# secure=True только за TLS; в локальной разработке по http оставить false
COOKIE_SECURE=false
# SameSite refresh-cookie. "lax" — фронт и api на одном сайте (Caddy локально,
# прод с одним доменом). "none" — фронт и api на разных доменах (Vercel →
# Render): браузер не отправит Lax-cookie в cross-site запросе. "none" требует
# COOKIE_SECURE=true (то есть HTTPS).
COOKIE_SAMESITE=lax
# JSON-массив origin'ов фронтенда для CORS. Пусто = cross-origin запрещён
# (локально фронт и api отдаёт один Caddy). Для Vercel указать его домен.
CORS_ORIGINS=[]
# принудительный TLS к Postgres (Neon и прочий managed включают его и по
# домену/host = *.neon.tech автоматически; см. app/shared/db.py)
DB_SSL_REQUIRE=false

# база API для фронтенда (frontend/.env, не бэкенда). Пусто = same-origin
# (локально / Caddy). В проде: https://<api-сервис>.onrender.com
VITE_API_URL=

# ---- Тонкая настройка (необязательно; значения по умолчанию в app/shared/config.py) ----
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# INVITATION_EXPIRE_DAYS=7
# WS_HEARTBEAT_SECONDS=30
# WS_MAX_CONNECTIONS_PER_USER=5
# RECLAIM_INTERVAL_SECONDS=30
